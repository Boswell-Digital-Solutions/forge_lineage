{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LineageIngestEnvelope.v1",
  "description": "Batch envelope: nodes are always processed before edges. Idempotent replay-safe.",
  "type": "object",
  "required": [
    "schema_version",
    "envelope_id",
    "writer_identity",
    "trace_id",
    "submitted_at",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "LineageIngestEnvelope.v1"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "writer_identity": {
      "type": "string",
      "enum": [
        "forge-eval",
        "eval-cal-node",
        "forgemath",
        "forgehq",
        "yellowjacket",
        "forgecommand",
        "smith",
        "dataforge-local",
        "fake-producer",
        "fake-consumer"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "LineageNode.v1.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "ImpactEdge.v1.schema.json"
      }
    }
  }
}