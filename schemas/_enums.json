{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge_lineage/schemas/_enums",
  "title": "ForgeLineageEnums",
  "description": "Locked enumerations for the initial ForgeLineage slice. This file is referenced by sibling schemas via $ref.",
  "definitions": {
    "node_type": {
      "type": "string",
      "enum": [
        "fake_producer_run",
        "fake_consumer_use",
        "fake_producer_artifact",
        "forge_eval_run",
        "forge_eval_artifact",
        "forge_eval_evidence_bundle",
        "eval_cal_record",
        "eval_cal_proposal",
        "eval_cal_gate_decision",
        "forgemath_input_bundle",
        "forgemath_evaluation",
        "forgemath_output",
        "forgemath_runtime_admission",
        "forgemath_trace",
        "forgehq_signal_intake",
        "forgehq_shaping_candidate",
        "forgehq_reviewability_result",
        "yellowjacket_workcell_request",
        "yellowjacket_run_trace",
        "yellowjacket_dependency_manifest",
        "yellowjacket_review_packet",
        "network_verification_observation",
        "network_verification_baseline_diff",
        "operator_decision"
      ]
    },
    "edge_type": {
      "type": "string",
      "enum": [
        "produced",
        "consumed",
        "consumed_by",
        "informed",
        "blocked",
        "required_review",
        "approved_for_promotion",
        "rejected_for_promotion",
        "superseded",
        "reviewed_by"
      ]
    },
    "causality_class": {
      "type": "string",
      "enum": [
        "deterministic",
        "derived",
        "declared",
        "observed",
        "operator_asserted",
        "unknown"
      ]
    },
    "effect_class": {
      "type": "string",
      "enum": [
        "advisory",
        "shaping",
        "calibration",
        "promotion",
        "mutation",
        "blocking",
        "informational"
      ]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "accepted",
        "pending",
        "rejected",
        "superseded",
        "stale"
      ]
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "unsigned",
        "signed",
        "invalid"
      ]
    },
    "lineage_availability": {
      "type": "string",
      "enum": [
        "lineage_available",
        "lineage_pending",
        "lineage_degraded",
        "lineage_invalid",
        "lineage_missing",
        "lineage_stale"
      ]
    },
    "writer_identity": {
      "type": "string",
      "enum": [
        "forge-eval",
        "eval-cal-node",
        "forgemath",
        "forgehq",
        "yellowjacket",
        "forgecommand",
        "smith",
        "dataforge-local",
        "fake-producer",
        "fake-consumer"
      ]
    },
    "error_class": {
      "type": "string",
      "enum": [
        "schema_invalid",
        "payload_schema_invalid",
        "unknown_writer",
        "idempotency_conflict",
        "duplicate_accepted",
        "source_node_missing",
        "target_node_missing",
        "edge_pending",
        "edge_invalid",
        "signature_invalid",
        "storage_error",
        "forbidden",
        "unknown"
      ]
    },
    "iso_8601": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
