{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceRef.v1",
  "description": "Reference to a piece of evidence supporting an edge or decision.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "evidence_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "EvidenceRef.v1"
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}