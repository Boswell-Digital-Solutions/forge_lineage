{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgemathTracePayload.v1",
  "type": "object",
  "required": ["schema_version", "trace_id", "lane_evaluation_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "forgemath_trace.v1"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lane_evaluation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "captured_at": {"type": "string", "format": "date-time"},
    "step_count": {"type": "integer", "minimum": 0}
  }
}
