{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YellowjacketDependencyManifestPayload.v1",
  "type": "object",
  "required": ["schema_version", "manifest_id", "captured_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "yellowjacket_dependency_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "captured_at": {"type": "string", "format": "date-time"},
    "dependency_count": {"type": "integer", "minimum": 0},
    "manifest_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
