{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgehqReviewabilityResultPayload.v1",
  "type": "object",
  "required": ["schema_version", "reviewability_id", "candidate_id", "state", "decided_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "forgehq_reviewability_result.v1"},
    "reviewability_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"type": "string", "enum": ["REVIEWABLE", "NOT_REVIEWABLE", "BLOCKED_BY_LINEAGE"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "block_reason_class": {"type": "string", "maxLength": 256},
    "lineage_availability": {
      "type": "string",
      "enum": [
        "lineage_available",
        "lineage_pending",
        "lineage_degraded",
        "lineage_invalid",
        "lineage_missing",
        "lineage_stale"
      ]
    }
  }
}
