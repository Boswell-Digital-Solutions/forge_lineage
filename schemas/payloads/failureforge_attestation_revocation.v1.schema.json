{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge_lineage/schemas/payloads/failureforge_attestation_revocation.v1",
  "title": "FailureForgeAttestationRevocationPayload.v1",
  "description": "Shape of the failureforge_attestation_revocation payload carried by a lineage node. forge_contract_core owns the family and its semantic rules (RFC-FFQ-02). This copy checks the shape only. A reader of a verdict must still verify the embedded proof, because a lineage write takes no credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_node_id",
    "key_id",
    "revoked_at",
    "reason",
    "revocation_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "failureforge_attestation_revocation.v1"
    },
    "verdict_node_id": {
      "type": "string",
      "pattern": "^ffav-[0-9a-f]{64}$"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "revoked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revocation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
